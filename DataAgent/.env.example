# 复制为 .env 并填写实际值

# ---- LLM 后端切换 ----
# ollama → 走 Ollama 远程推理服务（qwen3.8:27b）
# openai → 走 OpenAI 兼容代理（qwen3.5:9b）
# 二选一，切换后重启进程生效。
LLM_PROVIDER=ollama

# ---- Ollama（远程推理服务）----
OLLAMA_HOST=http://10.8.1.106:11434
OLLAMA_MODEL=qwen3.8:27b
# 客户端超时秒数（27b 冷启动首 token 约 128s，默认 300，一般不用改）
OLLAMA_TIMEOUT=300
# 上下文窗口（num_ctx，token 数）：qwen3.8:27b 支持到 256K，但必须显式设置才生效，
# 否则 Ollama 用默认值（几千 token）。2×48G 跑 128K 无压力；上调到 256K 前先在
# Ollama 服务端开 flash attention + KV cache 量化（见 DOCKER.md / 服务端配置）。
OLLAMA_NUM_CTX=131072

# ---- OpenAI 兼容代理（LLM_PROVIDER=openai 时使用）----
OPENAI_BASE_URL=https://aiproxy.agile-robots.cn/v1
OPENAI_API_KEY=
OPENAI_MODEL=qwen3.5:9b

TEMPERATURE=0.2

# 发给模型的历史字符上限（客户端裁剪）。字符数是粗估，20 万 ≈ 128K token 输入预算同量级；
# 要更激进吃满窗口就调大，prefill 太慢就调小。仅影响发送给模型的历史量，不影响落库。
MAX_HISTORY_CHARS=200000

# ---- 连接配置（数据库 / IoTDB / 日志目录）----
# 以下各项既是 .env 的「种子默认值」，也都可以在网页「🗄 数据库」弹窗里直接编辑；
# 网页里改完会写入 DataAgent/settings.json（已 gitignore），覆盖这里的值，且无需重启。
# 网页里删除某个 env 库时，其别名会记进 settings.json 的 deleted_databases，跨重启保持删除。

# ---- PostgreSQL：多数据库 ----
# 别名列表（逗号分隔，格式 别名:描述）；描述帮助 agent 理解库用途。
# 用户在提问里提到库名/别名时，agent 会用它选库（query_database / get_current_date 的 db 参数）。
DATABASES=agile_dispatch:AGV柔性产线调度库
# 默认库（用户没提库名时用；不设则用列表第一个）
DEFAULT_DATABASE=agile_dispatch

# 每个库的连接参数（DB_<别名大写>_HOST/PORT/DBNAME/USER/PASSWORD）
DB_AGILE_DISPATCH_HOST=
DB_AGILE_DISPATCH_PORT=5432
DB_AGILE_DISPATCH_DBNAME=agile_dispatch
DB_AGILE_DISPATCH_USER=
DB_AGILE_DISPATCH_PASSWORD=

# 再要加第二个库，示例（把 DATABASES 改成逗号分隔两项，并补下面的连接参数）：
# DATABASES=agile_dispatch:AGV柔性产线调度库,warehouse:仓库库存库
# DB_WAREHOUSE_HOST=
# DB_WAREHOUSE_PORT=5432
# DB_WAREHOUSE_DBNAME=warehouse
# DB_WAREHOUSE_USER=
# DB_WAREHOUSE_PASSWORD=

# ---- PostgreSQL（旧单库配置，作为 DATABASES 未设置时的回退）----
DB_HOST=
DB_PORT=5432
DB_NAME=agile_dispatch
DB_USER=
DB_PASSWORD=

# ---- Apache IoTDB 时序数据库（tools/iotdb.py，只读查询）----
# 记录产线工位状态变换；连接默认 10.8.22.20:6667 / root / root（不设也能连）
IOTDB_HOST=10.8.22.20
IOTDB_PORT=6667
IOTDB_USER=root
IOTDB_PASSWORD=root

# ---- 本机日志目录（tools/log_fetch.py，只读白名单目录）----
# LOG_DIR  日志根目录（默认 /var/log）
# LOG_DIRS 逗号分隔的多个允许目录（优先于 LOG_DIR）
LOG_DIR=/var/log
